# Dependencias y salidas de build
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
coverage/
playwright-report/
test-results/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Variables privadas / credenciales (mantener ejemplos ficticios)
.env
.env.*
!.env.example
!**/.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.kdbx
*.secret

# Bases SQLite y sidecars; prohibido publicarlas
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.wal
*.shm
*.dump
*.sql.gz

